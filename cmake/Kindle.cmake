set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(OXIDE_TOOLCHAINS "$ENV{OXIDE_TOOLCHAINS}" CACHE PATH "Koxtoolchain x-tools directory")
if(NOT OXIDE_ARCH MATCHES "^(kindle4|kindle5|kindlepw2|kindlehf)$")
    message(FATAL_ERROR "Set OXIDE_ARCH to kindle4, kindle5, kindlepw2, or kindlehf")
endif()
if(OXIDE_ARCH STREQUAL "kindlehf")
    set(triple arm-kindlehf-linux-gnueabihf)
elseif(OXIDE_ARCH STREQUAL "kindle4")
    set(triple arm-kindle5-linux-gnueabi)
else()
    set(triple arm-${OXIDE_ARCH}-linux-gnueabi)
endif()
set(CMAKE_C_COMPILER "${OXIDE_TOOLCHAINS}/${triple}/bin/${triple}-gcc")
set(CMAKE_CXX_COMPILER "${OXIDE_TOOLCHAINS}/${triple}/bin/${triple}-g++")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OXIDE_ARCH OXIDE_TOOLCHAINS)
